---
import Base from '../../layouts/Base.astro';
import PostRows from '../../components/PostRows.astro';
import { getPosts, tagCounts } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return tagCounts(posts).map(([tag]) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
---

<Base title={`태그: ${tag}`} description={`${tag} 태그가 붙은 글.`}>
  <div class="page-head ledger">
    <div class="rail">
      <a href="/notes/">전체 글</a><br />글 {posts.length}개
    </div>
    <div>
      <h1>{tag}</h1>
    </div>
  </div>
  <PostRows posts={posts} />
</Base>
