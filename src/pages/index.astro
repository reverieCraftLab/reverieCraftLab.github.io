---
import Base from '../layouts/Base.astro';
import PostRows from '../components/PostRows.astro';
import SeriesStem from '../components/SeriesStem.astro';
import { getPosts, seriesList, seriesParts, site, profile } from '../data/site';

const posts = await getPosts();
const series = seriesList[0];
const parts = seriesParts(posts, series.id);
---

<Base>
  <section class="hero" aria-label="소개">
    <div class="hero-main">
      <p class="eyebrow">{profile.eyebrow}</p>
      <p class="hero-lede">{site.intro}</p>
      <h1 class="hero-name">{profile.name}</h1>
      <p class="hero-desc">
        <strong>결과</strong>보다 <strong>결정한 이유</strong>를 남기는 <strong>백엔드 개발자</strong>입니다.
        테이블의 키, 트랜잭션의 경계, 버린 선택지까지 글로 적습니다.
      </p>
      <p class="hero-meta"><span>{profile.birth}</span><span>{profile.city}</span></p>
    </div>
    <aside class="hero-side">
      <h2 class="eyebrow">CURRENTLY</h2>
      <p class="hero-role">{profile.role}</p>
      <p class="hero-role-note">{profile.roleNote}</p>
      <h2 class="eyebrow focus-title">FOCUS</h2>
      <ul class="chips">
        {profile.focus.map((f) => <li>{f}</li>)}
      </ul>
    </aside>
  </section>

  <section class="block series-feature ledger" aria-labelledby="series-title">
    <div class="rail">
      쓰고 있는 시리즈<br />
      <span class="status">{series.status}</span>
    </div>
    <div>
      <h2 id="series-title"><a href={`/series/${series.id}/`}>{series.title}</a></h2>
      <p class="desc">{series.description}</p>
      <SeriesStem parts={parts} grow />
    </div>
  </section>

  <section class="block" aria-labelledby="recent-title">
    <div class="ledger" style="margin-bottom:1.5rem">
      <div class="rail"></div>
      <h2 class="section-title" id="recent-title">최근 글</h2>
    </div>
    <PostRows posts={posts.slice(0, 5)} />
  </section>

</Base>
